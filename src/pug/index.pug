                            h2 자격·어학
                            ul
                                li 정보처리기사 · 2025.09
                                li SQLD · 2024.09
                                li 네트워크관리사 2급 · 2026.09
                                li TOEIC 950 · 2025.05
                            p.small 최우수 성적 수료생 장관상 · 중소벤처기업부
            section#experience.resume-section
                .resume-section-content
                    p.eyebrow PROJECT EXPERIENCE
                    h2 프로젝트 경력 요약
                    p.section-intro 프로젝트를 선택하면 담당 범위와 주요 작업으로 이동합니다.
                    each company in [['기원테크','2025.08–현재','B2B 메일보안 솔루션 SendGUARD 개발·고도화'],['마인드프로','2022.12–2024.10','웹개발팀 주임 / 기업 웹 서비스 개발']]
                        article.company-group
                            .entry-header
                                h3= company[0]
                                p= company[1]
                            p.company-description= company[2]
                            .project-list
                                each project in projects.filter(p => p.company === company[0])
                                    a.project-row(id='summary-'+project.id, href='#project-'+project.id)
                                        .project-identity
                                            h4= project.title
                                            span.project-period= project.period
                                        p= project.summary
                                        span.project-action 상세 보기 ↓
            section#portfolio.resume-section
                .resume-section-content
                    p.eyebrow PROJECT DETAILS
                    h2 프로젝트 상세
                    p.section-intro 소속 회사와 프로젝트 안에서 직접 담당한 범위를 구분했습니다.
                    each project in projects
                        article.case-card(id='project-'+project.id, tabindex='-1', aria-labelledby='title-'+project.id)
                            p.case-label= project.company + ' / ' + project.period
                            h3(id='title-'+project.id)= project.title
                            .case-narrative
                                each part, index in project.caseSections
                                    section
                                        h4= String(index + 1).padStart(2, '0') + ' / ' + part[0]
                                        each paragraph in part[1].split('\n\n')
                                            p= paragraph
                            p.stack= project.stack
                            a.back-to-list(href='#summary-'+project.id) 프로젝트 목록으로 돌아가기 ↑
            section#skills.resume-section
                .resume-section-content
                    p.eyebrow TOOLKIT
                    h2 기술과 사용 경험
                    .skill-grid
                        each skill in [['백엔드','Java · Spring · Spring Boot','업무 로직, API, 정책 검증, 외부 연동 모듈'],['데이터 접근','MyBatis · JPA','조회·프로시저 연동, 엔티티 및 저장 로직'],['데이터베이스','MariaDB · MSSQL · Oracle','SQL 개발·개선, 데이터 모델, DB 전환 및 정합성 검증'],['웹 화면','JSP/JSTL · Thymeleaf · JavaScript/jQuery','관리자·사용자 화면, Ajax 요청과 이벤트 처리'],['운영 환경','Linux · Apache · Tomcat','고객사 배포·운영 반영, 요청 흐름과 장애 원인 분석'],['협업','Git · SVN','팀 프로젝트 형상관리와 변경 이력 관리']]
                            article
                                h3= skill[0]
                                p.skill-name= skill[1]
                                p= skill[2]
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
